<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".room_request">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="‹"
            android:textColor="@color/black"
            android:textSize="40sp"
            android:gravity="start|center_vertical" />

        <TextView
            android:id="@+id/tvHeaderRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Room Time"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="40dp"
            android:layout_height="0dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time Slots Available"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp"/>

            <RadioGroup
                android:id="@+id/rgTimeSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins">

                    <RadioButton
                        android:id="@+id/slot1"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="7:30 AM - 9:00 AM"
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                    <RadioButton
                        android:id="@+id/slot2"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="9:00 AM - 10:30 AM"
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                    <RadioButton
                        android:id="@+id/slot3"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="10:30 AM - 12:00 PM"
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                    <RadioButton
                        android:id="@+id/slot4"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="12:00 PM - 1:30 PM"
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                    <RadioButton
                        android:id="@+id/slot5"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="1:30 PM - 3:00 PM"
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                    <RadioButton
                        android:id="@+id/slot6"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="3:00 PM - 4:30 PM"
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                    <RadioButton
                        android:id="@+id/slot7"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="4:30 PM - 6:00 PM"
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                </GridLayout>
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnRequest"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="Next"
        android:textColor="@color/white"
        android:background="@drawable/bg_request_btn"
        app:backgroundTint="@null"/>
</LinearLayout>
